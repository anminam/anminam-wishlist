{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "3d7e57da8c95e4c3c5209d2334105517",
  "name": "anminam-wishlist",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://quiet-sound-416c.cloudflareaccess.com",
    "ACCESS_AUD": "0d15264719b1f37c8dbc939993febe1f62db892dffeee17f4fd7135500e28191"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anminam-wish-db",
      "database_id": "51b3690e-afee-46e8-968b-ddb20499bc48",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "WISH_IMAGES",
      "bucket_name": "anminam-wishlist-images"
    }
  ],
  "triggers": {
    "crons": ["20 18 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
